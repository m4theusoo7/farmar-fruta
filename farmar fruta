print("████ FRUIT SNIPER INICIADO █████")

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local player = Players.LocalPlayer
local placeId = game.PlaceId

print("Blox Fruits | Farm de Frutas Míticas | PlaceId: " .. tostring(placeId))
print("Fruit Sniper: sistema de farm ativado.")

local CONFIG = {
	FRUIT_KEYWORD = "Fruit",
	SCAN_TIMEOUT = 5,
	TWEEN_TIME = 2,
	COLLECT_SETTLE_TIME = 2,
	SERVER_LIMIT = 100,
}

local MYTHICAL_FRUITS = {
	"leopard", "dragon", "kitsune", "spirit", "venom", "dough",
	"shadow", "gravity", "mammoth", "trex",
}

local function normalizeFruitName(name: string): string
	local normalized = string.lower(name or "")
	normalized = string.gsub(normalized, "%s", "")
	normalized = string.gsub(normalized, "fruit", "")
	return normalized
end

local function isMythicalFruit(name: string): boolean
	local normalized = normalizeFruitName(name)
	for _, mythical in ipairs(MYTHICAL_FRUITS) do
		if normalized == mythical then
			return true
		end
	end
	return false
end

local function findMythicalFruit(): Instance?
	local descendants = Workspace:GetDescendants()
	print("Fruit Sniper: escaneando " .. tostring(#descendants) .. " instancias no workspace...")
	for _, instance in ipairs(descendants) do
		if instance:IsA("Model") and instance.Name:find(CONFIG.FRUIT_KEYWORD, 1, true) then
			if isMythicalFruit(instance.Name) then
				print("Fruit Sniper: fruta mítica detectada -> " .. tostring(instance.Name))
				return instance
			end
		end
	end
	return nil
end

local function getFruitPosition(fruit: Instance): Vector3?
	if not fruit:IsA("Model") then
		return nil
	end
	local primaryPart = fruit.PrimaryPart
	if not primaryPart then
		local children = fruit:GetChildren()
		for _, child in ipairs(children) do
			if child:IsA("BasePart") then
				primaryPart = child
				break
			end
		end
	end
	if not primaryPart then
		return nil
	end
	return primaryPart.Position
end

local function movePlayerToPosition(targetPosition: Vector3): boolean
	local character = player.Character
	if not character then
		return false
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then
		return false
	end

	local tweenInfo = TweenInfo.new(
		CONFIG.TWEEN_TIME,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		0,
		false,
		0
	)

	local success, tween = pcall(function()
		return TweenService:Create(rootPart, tweenInfo, { CFrame = CFrame.new(targetPosition) })
	end)

	if not success or type(tween) ~= "Tween" then
		humanoid:MoveTo(targetPosition)
		return false
	end

	tween:Play()
	tween.Completed:Wait()
	return true
end

local visitedServers: { [number]: boolean } = {}

local function markServerVisited(serverId: number): boolean
	if visitedServers[serverId] then
		return false
	end
	visitedServers[serverId] = true
	return true
end

local function isServerVisited(serverId: number): boolean
	return visitedServers[serverId] == true
end

local function getAvailableServer(): number?
	local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) ..
		"/servers?limit=" .. tostring(CONFIG.SERVER_LIMIT)

	print("Fruit Sniper: buscando servidores publicos...")
	local ok, response = pcall(function()
		return HttpService:GetAsync(url)
	end)

	if not ok or type(response) ~= "string" then
		warn("Fruit Sniper: falha ao buscar servidores publicos.")
		return nil
	end

	local okJson, body = pcall(function()
		return HttpService:JSONDecode(response)
	end)

	if not okJson or type(body) ~= "table" then
		warn("Fruit Sniper: resposta invalida da API de servidores.")
		return nil
	end

	local servers = body.data
	if type(servers) ~= "table" then
		return nil
	end

	for _, server in ipairs(servers) do
		if type(server) == "table" then
			local serverId = server.id
			local playingCount = server.playingCount or 0
			local maxPlayers = server.maxPlayers or 100

			if playingCount < maxPlayers and not isServerVisited(serverId) then
				markServerVisited(serverId)
				return serverId
			end
		end
	end

	return nil
end

local function teleportToServer(serverId: number): boolean
	local success, err = pcall(function()
		return TeleportService:TeleportAsync(placeId, player, serverId)
	end)

	if not success then
		visitedServers[serverId] = nil
		warn("Fruit Sniper: falha ao teleportar -> " .. tostring(err))
		return false
	end

	return true
end

while true do
	local mythicalFruit = findMythicalFruit()

	if mythicalFruit then
		local fruitPosition = getFruitPosition(mythicalFruit)
		if fruitPosition then
			movePlayerToPosition(fruitPosition)
		end
		task.wait(CONFIG.COLLECT_SETTLE_TIME)
	else
		print("NENHUMA FRUTA MITICA ENCONTRADA - PRONTO PARA SERVER HOP")

		task.wait(CONFIG.SCAN_TIMEOUT)

		local nextServerId = getAvailableServer()
		if nextServerId then
			print("Fruit Sniper: teleportando para o servidor " .. tostring(nextServerId))
			teleportToServer(nextServerId)
		else
			task.wait(10)
		end
	end
end
